{
  "id": "org.fieldlab.premiere.bridge",
  "name": "Field Lab",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "http://127.0.0.1:8766",
        "http://127.0.0.1:18798"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "fieldlab",
      "type": "panel",
      "minimumSize": {
        "width": 320,
        "height": 300
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 500
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 600
      },
      "label": {
        "default": "Field Lab"
      }
    }
  ]
}
